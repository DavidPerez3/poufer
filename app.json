{
  "expo": {
    "name": "Poufer",
    "slug": "poufer",
    "version": "0.4.0",
    "orientation": "portrait",
    "scheme": "poufer",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10081f"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/poufer"
    }
  }
}
